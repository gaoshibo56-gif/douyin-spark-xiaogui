# 网页访问令牌。留空则不校验（部署脚本会自动生成随机值）
AUTH_TOKEN=
# 服务监听端口
PORT=8001
# 监听地址。多实例经 nginx 转发时可设为 127.0.0.1
# HOST=0.0.0.0

# 数据目录（config.json / state.json / runtime.json / logs 所在目录）。
# 默认是代码目录下的 data/。多实例共用一个代码目录时，为每个实例指定独立目录，
# 例如 DATA_DIR=/var/lib/douyin-spark/1
# DATA_DIR=

# 要加载的 .env 文件路径。默认是代码目录下的 .env。
# 多实例可各自准备一份 .env，例如 ENV_FILE=/etc/douyin-spark/1.env
# ENV_FILE=
